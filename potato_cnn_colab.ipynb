  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 基于卷积神经网络的马铃薯叶片病害图像分类研究\n",
        "\n",
        "按顺序运行即可。三类各30张，按官方叶片组隔离划分；CPU训练3个种子，每次10轮。比较第5轮与第10轮。\n",
        "\n",
        "这是小样本课程实验，不代表田间或无人机识别性能。
      ],
      "id": "cell-00"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "%pip -q install torch numpy pillow scikit-learn matplotlib\n"
      ],
      "outputs": [],
      "execution_count": null,
      "id": "cell-01"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1 配置与来源"
      ],
      "id": "cell-02"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "\"\"\"马铃薯叶片 CNN 课程实验。\n",
        "算法依据 LeCun et al. 1998, doi:10.1109/5.726791；框架 PyTorch。\n",
        "数据与叶片组：https://github.com/spMohanty/PlantVillage-Dataset\n",
        "使用官方接口组织实现，不复刻原论文网络，不使用预训练权重。\n",
        "\"\"\"\n",
        "from pathlib import Path\n",
        "import urllib.request, urllib.parse, json, random, hashlib, io, csv, time\n",
        "from concurrent.futures import ThreadPoolExecutor\n",
        "ROOT = Path('potato_coursework_run')\n",
        "ROOT.mkdir(exist_ok=True)\n",
        "OUT = ROOT / 'results'\n",
        "OUT.mkdir(exist_ok=True)\n",
        "COMMIT = '7f7ecc7e1eaca78107e3affe7cb5abd9427e139a'\n",
        "REPO = 'https://github.com/spMohanty/PlantVillage-Dataset'\n",
        "RAW = f'https://raw.githubusercontent.com/spMohanty/PlantVillage-Dataset/{COMMIT}/'\n",
        "CLASSES = ['Potato___healthy', 'Potato___Early_blight', 'Potato___Late_blight']\n",
        "SPLIT_SEED = 2026\n",
        "TRAIN_SEEDS = [2026, 2027, 2028]\n",
        "# 固定 CPU，便于普通电脑和 Colab 使用；不是田间或无人机数据。\n",
        "\n",
        "def fetch(url):\n",
        "    for attempt in range(3):\n",
        "        try:\n",
        "            req = urllib.request.Request(url, headers={'User-Agent':'potato-coursework'})\n",
        "            with urllib.request.urlopen(req, timeout=45) as response:\n",
        "                return response.read()\n",
        "        except Exception:\n",
        "            if attempt == 2: raise\n",
        "            time.sleep(attempt+1)\n",
        "\n",
        "def write_json(path, data):\n",
        "    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')\n",
        "\n",
        "def write_csv(path, rows):\n",
        "    with path.open('w', newline='', encoding='utf-8-sig') as f:\n",
        "        writer = csv.DictWriter(f, fieldnames=list(rows[0]))\n",
        "        writer.writeheader(); writer.writerows(rows)\n",
        "\n"
      ],
      "outputs": [],
      "execution_count": null,
      "id": "cell-03"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2 下载真实图片 先按叶片组划分 后抽样"
      ],
      "id": "cell-04"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from PIL import Image\n",
        "map_bytes = fetch(RAW+'leaf-map.json')\n",
        "(OUT/'leaf-map.json').write_bytes(map_bytes)\n",
        "leaf_map = {k.lower(): v for k,v in json.loads(map_bytes).items()}\n",
        "manifest = []\n",
        "coverage = []\n",
        "for label, category in enumerate(CLASSES):\n",
        "    listing = json.loads(fetch(f'https://api.github.com/repos/spMohanty/PlantVillage-Dataset/contents/raw/color/{category}?ref={COMMIT}'))\n",
        "    assert isinstance(listing, list), '数据目录读取失败，检查网络或 GitHub API 限额'\n",
        "    candidates = []\n",
        "    for item in sorted(listing, key=lambda d:d['name']):\n",
        "        name = item['name']\n",
        "        if item['type']!='file' or not name.lower().endswith(('.jpg','.jpeg','.png')): continue\n",
        "        # 文件名 UUID 后面的原始照片名对应官方 leaf-map 的键。\n",
        "        key = Path(name.split('___',1)[-1]).stem.lower()\n",
        "        groups = leaf_map.get(key, [])\n",
        "        # 无映射或映射有歧义的照片排除，绝不默认当成独立叶片。\n",
        "        if len(groups)!=1 or not groups[0].startswith(category+':::'): continue\n",
        "        candidates.append({'label':label,'category':category,'filename':name,'leaf_group':groups[0]})\n",
        "    groups = sorted({r['leaf_group'] for r in candidates})\n",
        "    random.Random(SPLIT_SEED+label).shuffle(groups)\n",
        "    a, b = int(len(groups)*.6), int(len(groups)*.8)\n",
        "    buckets = {'train':set(groups[:a]), 'validation':set(groups[a:b]), 'test':set(groups[b:])}\n",
        "    for j,(split,n) in enumerate([('train',20),('validation',5),('test',5)]):\n",
        "        pool = [r for r in candidates if r['leaf_group'] in buckets[split]]\n",
        "        random.Random(SPLIT_SEED+100*label+j).shuffle(pool)\n",
        "        assert len(pool)>=n, f'{category} {split} 映射后图片不足'\n",
        "        for row in pool[:n]:\n",
        "            row = dict(row, split=split)\n",
        "            relative = 'raw/color/'+category+'/'+row['filename']\n",
        "            row['source_url'] = RAW+urllib.parse.quote(relative, safe='/')\n",
        "            row['local_path'] = str(ROOT/'images'/category/row['filename'])\n",
        "            manifest.append(row)\n",
        "    coverage.append({'category':category,'listed_images':len(listing),'mapped_images':len(candidates),'mapped_groups':len(groups)})\n",
        "\n",
        "def download(row):\n",
        "    path = Path(row['local_path']); path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    if not path.exists(): path.write_bytes(fetch(row['source_url']))\n",
        "    raw = path.read_bytes()\n",
        "    with Image.open(io.BytesIO(raw)) as im:\n",
        "        im.verify()\n",
        "    with Image.open(io.BytesIO(raw)) as im:\n",
        "        rgb = im.convert('RGB')\n",
        "        row['pixel_sha256'] = hashlib.sha256(str(rgb.size).encode()+rgb.tobytes()).hexdigest()\n",
        "    row['sha256'] = hashlib.sha256(raw).hexdigest()\n",
        "    return row\n",
        "\n",
        "with ThreadPoolExecutor(max_workers=6) as executor:\n",
        "    manifest = list(executor.map(download, manifest))\n",
        "for i, left in enumerate(manifest):\n",
        "    for right in manifest[i+1:]:\n",
        "        if left['split'] != right['split']:\n",
        "            assert left['leaf_group']!=right['leaf_group'], '叶片组跨集合'\n",
        "            assert left['pixel_sha256']!=right['pixel_sha256'], '重复图片跨集合'\n",
        "write_csv(OUT/'manifest.csv', manifest)\n",
        "write_json(OUT/'data_audit.json', {'commit':COMMIT,'map_sha256':hashlib.sha256(map_bytes).hexdigest(),'coverage':coverage,'cross_split_group_overlap':0,'cross_split_exact_pixel_duplicates':0,'limitation':'官方映射不能保证所有潜在关联或近重复均被识别'})\n",
        "print('已准备90张真实照片，训练60、验证15、测试15；组隔离与像素完全重复检查通过。', flush=True)\n",
        "\n"
      ],
      "outputs": [],
      "execution_count": null,
      "id": "cell-05"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3 图像转成张量 并定义模型"
      ],
      "id": "cell-06"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "import torch\n",
        "from torch import nn\n",
        "from torch.utils.data import TensorDataset, DataLoader\n",
        "from sklearn.metrics import accuracy_score, f1_score, confusion_matrix, classification_report\n",
        "import matplotlib\n",
        "matplotlib.use('Agg')\n",
        "import matplotlib.pyplot as plt\n",
        "import platform, importlib.metadata, datetime, copy\n",
        "\n",
        "torch.set_num_threads(2)\n",
        "torch.use_deterministic_algorithms(True)\n",
        "X = np.stack([np.asarray(Image.open(r['local_path']).convert('RGB').resize((64,64),Image.Resampling.BILINEAR),dtype=np.float32).transpose(2,0,1)/255 for r in manifest])\n",
        "y = np.array([r['label'] for r in manifest], dtype=np.int64)\n",
        "indices = {s:[i for i,r in enumerate(manifest) if r['split']==s] for s in ['train','validation','test']}\n",
        "\n",
        "def loader(split, seed=0):\n",
        "    ids = indices[split]\n",
        "    return DataLoader(TensorDataset(torch.tensor(X[ids]),torch.tensor(y[ids])), batch_size=16,shuffle=split=='train',num_workers=0,generator=torch.Generator().manual_seed(seed))\n",
        "\n",
        "class SmallCNN(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.features = nn.Sequential(nn.Conv2d(3,16,3,padding=1),nn.ReLU(),nn.MaxPool2d(2),nn.Conv2d(16,32,3,padding=1),nn.ReLU(),nn.MaxPool2d(2),nn.AdaptiveAvgPool2d((4,4)))\n",
        "        self.classifier = nn.Linear(512,3)\n",
        "    def forward(self,x):\n",
        "        return self.classifier(self.features(x).flatten(1))\n",
        "\n",
        "loss_fn = nn.CrossEntropyLoss()\n",
        "\n",
        "def evaluate(model, data):\n",
        "    model.eval(); total=0.; true=[]; pred=[]; probs=[]\n",
        "    with torch.no_grad():\n",
        "        for bx,by in data:\n",
        "            logits=model(bx)\n",
        "            total+=loss_fn(logits,by).item()*len(by)\n",
        "            true.extend(by.tolist()); pred.extend(logits.argmax(1).tolist())\n",
        "            probs.extend(logits.softmax(1).tolist())\n",
        "    return {'loss':total/len(true),'accuracy':float(accuracy_score(true,pred)),'macro_f1':float(f1_score(true,pred,labels=[0,1,2],average='macro',zero_division=0)),'true':true,'pred':pred,'probabilities':probs}\n",
        "\n"
      ],
      "outputs": [],
      "execution_count": null,
      "id": "cell-07"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4 三个训练种子 每次保存第5轮和第10轮"
      ],
      "id": "cell-08"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "histories=[]; checkpoints={}; training_times={}\n",
        "for seed in TRAIN_SEEDS:\n",
        "    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed)\n",
        "    model=SmallCNN(); optimizer=torch.optim.Adam(model.parameters(),lr=.001)\n",
        "    train=loader('train',seed); valid=loader('validation')\n",
        "    start=time.perf_counter()\n",
        "    for epoch in range(1,11):\n",
        "        model.train(); total=0.; count=0\n",
        "        for bx,by in train:\n",
        "            optimizer.zero_grad(); logits=model(bx); loss=loss_fn(logits,by)\n",
        "            loss.backward(); optimizer.step()\n",
        "            total+=loss.item()*len(by); count+=len(by)\n",
        "        v=evaluate(model,valid)\n",
        "        histories.append({'seed':seed,'epoch':epoch,'train_loss':total/count,'val_loss':v['loss'],'val_accuracy':v['accuracy'],'val_macro_f1':v['macro_f1']})\n",
        "        print(f\"seed={seed} epoch={epoch:02d} train_loss={total/count:.4f} val_acc={v['accuracy']:.3f}\",flush=True)\n",
        "        if epoch in (5,10):\n",
        "            checkpoints[(seed,epoch)]=copy.deepcopy(model.state_dict())\n",
        "            torch.save(model.state_dict(),OUT/f'cnn_seed{seed}_epoch{epoch}.pth')\n",
        "    training_times[str(seed)]=time.perf_counter()-start\n",
        "write_csv(OUT/'history.csv',histories)\n",
        "\n"
      ],
      "outputs": [],
      "execution_count": null,
      "id": "cell-09"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5 训练全部结束后 统一测试 不根据测试分数调整实验"
      ],
      "id": "cell-10"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "scores=[]; predictions=[]; all_results={}\n",
        "for seed in TRAIN_SEEDS:\n",
        "    for epoch in (5,10):\n",
        "        model.load_state_dict(checkpoints[(seed,epoch)])\n",
        "        r=evaluate(model,loader('test')); all_results[f'{seed}_{epoch}']=r\n",
        "        scores.append({'seed':seed,'epoch':epoch,'test_loss':r['loss'],'accuracy':r['accuracy'],'macro_f1':r['macro_f1']})\n",
        "        for i,index in enumerate(indices['test']):\n",
        "            predictions.append({'seed':seed,'epoch':epoch,'filename':manifest[index]['filename'],'leaf_group':manifest[index]['leaf_group'],'true':r['true'][i],'pred':r['pred'][i],**{f'p_{k}':r['probabilities'][i][k] for k in range(3)}})\n",
        "        cm=confusion_matrix(r['true'],r['pred'],labels=[0,1,2])\n",
        "        fig,ax=plt.subplots(figsize=(4,3.5)); ax.imshow(cm,cmap='Blues',vmin=0,vmax=5)\n",
        "        for i in range(3):\n",
        "            for j in range(3): ax.text(j,i,str(cm[i,j]),ha='center',va='center')\n",
        "        ax.set(xticks=range(3),yticks=range(3),xticklabels=['Healthy','Early','Late'],yticklabels=['Healthy','Early','Late'],xlabel='Predicted',ylabel='True',title=f'Seed {seed}, epoch {epoch}')\n",
        "        fig.tight_layout(); fig.savefig(OUT/f'confusion_seed{seed}_epoch{epoch}.png',dpi=180); plt.close(fig)\n",
        "        write_json(OUT/f'classification_seed{seed}_epoch{epoch}.json',classification_report(r['true'],r['pred'],labels=[0,1,2],target_names=CLASSES,zero_division=0,output_dict=True))\n",
        "write_csv(OUT/'metrics.csv',scores); write_csv(OUT/'predictions.csv',predictions)\n",
        "summary=[]\n",
        "for epoch in (5,10):\n",
        "    subset=[r for r in scores if r['epoch']==epoch]\n",
        "    summary.append({'epoch':epoch,**{f'{key}_{stat}':float(func([r[key] for r in subset])) for key in ['accuracy','macro_f1'] for stat,func in [('mean',np.mean),('std',lambda a:np.std(a,ddof=1))]}})\n",
        "fig,axes=plt.subplots(1,3,figsize=(12,3.3))\n",
        "for ax,seed in zip(axes,TRAIN_SEEDS):\n",
        "    rows=[h for h in histories if h['seed']==seed]\n",
        "    ax.plot(range(1,11),[r['train_loss'] for r in rows],label='Train')\n",
        "    ax.plot(range(1,11),[r['val_loss'] for r in rows],label='Validation')\n",
        "    ax.set(xlabel='Epoch',ylabel='Cross entropy',title=f'Seed {seed}'); ax.legend()\n",
        "fig.tight_layout();fig.savefig(OUT/'loss_curves.png',dpi=180);plt.close(fig)\n",
        "# 展示首个种子的真实测试预测案例，选取顺序固定，不挑高分案例。\n",
        "r=all_results[f'{TRAIN_SEEDS[0]}_10']; fig,axes=plt.subplots(2,3,figsize=(9,6))\n",
        "for ax,i in zip(axes.flat,range(6)):\n",
        "    ax.imshow(X[indices['test'][i]].transpose(1,2,0)); ax.set_title(f\"True: {['Healthy','Early','Late'][r['true'][i]]}\\nPred: {['Healthy','Early','Late'][r['pred'][i]]}\");ax.axis('off')\n",
        "fig.tight_layout();fig.savefig(OUT/'prediction_cases.png',dpi=180);plt.close(fig)\n",
        "# 平衡测试集的固定类别预测基线。它不使用测试集拟合。\n",
        "baseline={'accuracy':float(accuracy_score(y[indices['test']],np.zeros(15,dtype=int))),'macro_f1':float(f1_score(y[indices['test']],np.zeros(15,dtype=int),labels=[0,1,2],average='macro',zero_division=0))}\n",
        "environment={'python':platform.python_version(),'platform':platform.platform(),'processor':platform.processor(),'device':'cpu','threads':torch.get_num_threads(),'packages':{p:importlib.metadata.version(p) for p in ['torch','numpy','Pillow','scikit-learn','matplotlib']},'utc_time':datetime.datetime.now(datetime.timezone.utc).isoformat(),'training_seconds':training_times}\n",
        "write_json(OUT/'environment.json',environment)\n",
        "write_json(OUT/'results.json',{'status':'completed','source':REPO,'commit':COMMIT,'split_seed':SPLIT_SEED,'train_seeds':TRAIN_SEEDS,'classes':CLASSES,'n_train':60,'n_validation':15,'n_test':15,'split_method':'official leaf-map groups split first, then sample 20/5/5 per class','parameters':sum(p.numel() for p in model.parameters()),'scores':scores,'summary':summary,'constant_baseline':baseline,'history':histories,'test_results':all_results,'environment':environment,'limitations':['90 images only; 15 test images','fixed split; seeds vary training randomness only','leaf-map may be incomplete','controlled backgrounds; no field/UAV validation']})\n",
        "write_json(OUT/'config.json',{'commit':COMMIT,'split_seed':SPLIT_SEED,'train_seeds':TRAIN_SEEDS,'image_size':64,'batch_size':16,'lr':.001,'epochs':10,'normalization':'[0,1]','augmentation':False,'pretrained':False})\n",
        "# 留存实际执行的代码，便于核对；笔记本执行时由其单独保存。\n",
        "if '__file__' in globals():\n",
        "    import shutil\n",
        "    shutil.copyfile(__file__,OUT/'executed_potato_cnn.py')\n",
        "import zipfile\n",
        "with zipfile.ZipFile('coursework_results.zip','w',zipfile.ZIP_DEFLATED) as z:\n",
        "    for path in sorted(OUT.iterdir()): z.write(path,'results/'+path.name)\n",
        "print('完成，真实指标如下：',json.dumps(summary,ensure_ascii=False),flush=True)\n",
        "print('结果文件：coursework_results.zip；请下载并交回以完成报告。')\n"
      ],
      "outputs": [],
      "execution_count": null,
      "id": "cell-11"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6 下载结果\n",
        "\n",
        "程序成功结束后，下载此ZIP并发回聊天。即使准确率低也保留真实结果，不修改测试集或挑选种子。"
